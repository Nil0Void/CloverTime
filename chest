-- Main Farming Loop (Chests + Mana Crystals)
task.spawn(function()
    local lastUndergroundCFrame = nil

    while true do
        task.wait()
        
        if AutoFarm then
            pcall(function()
                local targetsList = {}

                -- 1. Get targets from world_chests based on matching names
                local chestsFolder = Workspace:FindFirstChild("world_chests")
                if chestsFolder then
                    for _, chest in ipairs(chestsFolder:GetChildren()) do
                        if Targets[chest.Name] then
                            table.insert(targetsList, chest)
                        end
                    end
                end

                -- 2. Get ALL targets from mana_crystals regardless of specific item names
                local manaFolder = Workspace:FindFirstChild("mana_crystals")
                if manaFolder then
                    for _, item in ipairs(manaFolder:GetChildren()) do
                        table.insert(targetsList, item)
                    end
                end

                local foundTarget = false

                -- Process collected targets
                for i = 1, #targetsList do
                    if not AutoFarm then break end
                    
                    local target = targetsList[i]
                    if target and target.Parent then
                        local cframe = GetChestCFrame(target)
                        
                        if cframe then
                            foundTarget = true
                            LastChestTime = tick()
                            StatusLabel.Text = "Target: " .. target.Name
                            lastUndergroundCFrame = cframe * CFrame.new(0, -7, 0)
                            FastTeleport(cframe)
                            FastInteract(target)
                        end
                    end
                end

                -- Check 3-Minute Server Hop Timeout
                local idleTime = math.floor(tick() - LastChestTime)
                if idleTime >= SERVER_HOP_TIMEOUT then
                    ServerHop()
                    task.wait(5)
                end

                -- Hold underground position if idle
                if not foundTarget and lastUndergroundCFrame then
                    local remaining = SERVER_HOP_TIMEOUT - idleTime
                    StatusLabel.Text = string.format("Underground (Hop in %ds)", math.max(0, remaining))
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        char:PivotTo(lastUndergroundCFrame)
                        char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                    end
                elseif not foundTarget and not lastUndergroundCFrame then
                    local remaining = SERVER_HOP_TIMEOUT - idleTime
                    StatusLabel.Text = string.format("Searching (Hop in %ds)", math.max(0, remaining))
                end
            end)
        end
    end
end)
