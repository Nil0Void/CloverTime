-- Main Loop
task.spawn(function()
    local lastUndergroundCFrame = nil

    while true do
        task.wait()
        
        if AutoFarm then
            pcall(function()
                local folder = Workspace:FindFirstChild("world_chests")
                local foundChest = false

                if folder then
                    local children = folder:GetChildren()
                    
                    for i = 1, #children do
                        if not AutoFarm then break end
                        
                        local chest = children[i]
                        if chest and chest.Parent and Targets[chest.Name] then
                            local cframe = GetChestCFrame(chest)
                            
                            if cframe then
                                foundChest = true
                                LastChestTime = tick() -- Reset server hop timer upon chest touch
                                StatusLabel.Text = "Target: " .. chest.Name
                                lastUndergroundCFrame = cframe * CFrame.new(0, -7, 0)
                                FastTeleport(cframe)
                                FastInteract(chest)
                            end
                        end
                    end
                else
                    StatusLabel.Text = "Status: 'world_chests' missing"
                end

                -- Check 3-Minute Idle Server Hop Timeout
                local idleTime = math.floor(tick() - LastChestTime)
                if idleTime >= SERVER_HOP_TIMEOUT then
                    ServerHop()
                    task.wait(5)
                end

                -- Hold 7 studs underground if waiting for chests
                if not foundChest and lastUndergroundCFrame then
                    local remaining = SERVER_HOP_TIMEOUT - idleTime
                    StatusLabel.Text = string.format("Underground (Hop in %ds)", math.max(0, remaining))
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        char:PivotTo(lastUndergroundCFrame)
                        char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                    end
                elseif not foundChest and not lastUndergroundCFrame then
                    local remaining = SERVER_HOP_TIMEOUT - idleTime
                    StatusLabel.Text = string.format("Searching (Hop in %ds)", math.max(0, remaining))
                end
            end)
        end
    end
end)
