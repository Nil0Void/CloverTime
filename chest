    end
end)

-- Loop 2: BLINK_RELIABLE_REMOTE (Dynamic Key Buffer Injector)
task.spawn(function()
    while true do
        if AutoFarm then
            pcall(function()
                local remote = GetRemote("BLINK_RELIABLE_REMOTE")
                if remote then
                    local itemKey = GetDynamicEquipKey()
                    
                    if itemKey then
                        local bufferString = "\014\031\000\005\000" .. itemKey .. "equip"
                        remote:FireServer(unpack({
                            buffer.fromstring(bufferString),
                            {}
                        }))
                    end
                end
            end)
        end
        task.wait(0.15)
    end
end)

-- Loop 3: Pull & Hold Chest Items from Backpack / AiPlayer_205 / Nil
task.spawn(function()
    while true do
        if AutoFarm then
            pcall(function()
                local char = LocalPlayer.Character
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                local aiPlayer = Workspace:FindFirstChild("characters") and Workspace.characters:FindFirstChild("AiPlayer_205")

                for chestName, _ in pairs(SelectedChestNames) do
                    if backpack then
                        local tool = backpack:FindFirstChild(chestName)
                        if tool and humanoid then
                            humanoid:EquipTool(tool)
                        end
                    end

                    if aiPlayer then
                        local aiChest = aiPlayer:FindFirstChild(chestName)
                        if aiChest and char then
                            aiChest.Parent = char
                        end
                    end

                    local nilChest = GetNilInstance(chestName)
                    if nilChest and char then
                        nilChest.Parent = char
                    end
                end
            end)
        end
        task.wait(0.15)
    end
end)

