-- Safely get physical CFrame from any Part or Model
local function GetChestCFrame(chest)
    if chest:IsA("BasePart") then
        return chest.CFrame
    elseif chest:IsA("Model") then
        return chest:GetPivot()
    end
    return nil
end

-- Force Server Position Sync & Teleport 0.3 units above
local function HardTeleport(targetCFrame)
    local char = LocalPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local goalCFrame = targetCFrame + Vector3.new(0, 0.3, 0)

    -- 1. Request stream loading around the chest area if StreamingEnabled is on
    pcall(function()
        LocalPlayer:RequestStreamAroundAsync(goalCFrame.Position)
    end)

    -- 2. Pivot the entire character assembly
    char:PivotTo(goalCFrame)
    
    -- 3. Reset physics velocity so the server registers character arrival immediately
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

-- Multi-Type Interaction Trigger
local function Interact(chest)
    local foundInteraction = false
    
    -- Check for Prompts/Clickers
    for _, desc in ipairs(chest:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled then
            foundInteraction = true
            for i = 1, 3 do
                if fireproximityprompt then
                    fireproximityprompt(desc)
                else
                    desc:InputHoldBegin()
                    task.wait(0.1)
                    desc:InputHoldEnd()
                end
                task.wait(0.1)
            end
        elseif desc:IsA("ClickDetector") then
            foundInteraction = true
            for i = 1, 3 do
                if fireclickdetector then
                    fireclickdetector(desc)
                else
                    desc:Click()
                end
                task.wait(0.1)
            end
        end
    end

    -- Fallback: Rapid Center-Screen Taps (3 taps, 0.1s hold each)
    if not foundInteraction then
        local viewport = Workspace.CurrentCamera.ViewportSize
        local cx, cy = viewport.X / 2, viewport.Y / 2
        for i = 1, 3 do
            VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.Begin, cx, cy)
            task.wait(0.1)
            VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.End, cx, cy)
            task.wait(0.1)
        end
    end
end

-- Toggle Event
ToggleBtn.MouseButton1Click:Connect(function()
    AutoFarm = not AutoFarm
    ToggleBtn.Text = AutoFarm and "FARM: ON" or "FARM: OFF"
    ToggleBtn.BackgroundColor3 = AutoFarm and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(180, 50, 50)
end)

-- Main Execution Loop
task.spawn(function()
    while true do
        task.wait(0.15)
        
        if AutoFarm then
            pcall(function()
                local folder = Workspace:FindFirstChild("world_chests")
                if folder then
                    local chests = folder:GetChildren()
                    
                    for i = 1, #chests do
                        if not AutoFarm then break end
                        
                        local chest = chests[i]
                        if chest and chest.Parent and Targets[chest.Name] then
                            local cframe = GetChestCFrame(chest)
                            
                            if cframe then
                                -- Force server-synced position move
                                HardTeleport(cframe)
                                task.wait(0.15) -- Brief wait for server network replication
                                
                                Interact(chest)
                                task.wait(0.1)
                            end
                        end
                    end
                end
            end)
        end
    end
end)
