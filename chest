-- Core Character Helper
local function GetRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- Position Sync Helper (Teleport + Server Position Force)
local function MoveToTarget(targetCFrame)
    local root = GetRoot()
    if not root then return end
    
    local goalCFrame = targetCFrame + Vector3.new(0, 0.3, 0)
    
    -- Tween over 0.05s so the server registers physical movement and loads prompts
    local tweenInfo = TweenInfo.new(0.05, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(root, tweenInfo, {CFrame = goalCFrame})
    tween:Play()
    tween.Completed:Wait()
    
    root.CFrame = goalCFrame
end

-- Universal Interaction Function
local function MultiInteract(targetInstance)
    -- 1. Try Direct ProximityPrompts & ClickDetectors
    local interacted = false
    for _, desc in ipairs(targetInstance:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled then
            for i = 1, 3 do
                if fireproximityprompt then
                    fireproximityprompt(desc)
                else
                    desc:InputHoldBegin()
                    task.wait(0.1)
                    desc:InputHoldEnd()
                end
                task.wait(0.1)
            end
            interacted = true
        elseif desc:IsA("ClickDetector") then
            for i = 1, 3 do
                if fireclickdetector then
                    fireclickdetector(desc)
                else
                    desc:Click()
                end
                task.wait(0.1)
            end
            interacted = true
        end
    end

    -- 2. Fallback Screen Tap (3 rapid taps at 0.1s holding interval)
    if not interacted then
        local viewport = Workspace.CurrentCamera.ViewportSize
        local cx, cy = viewport.X / 2, viewport.Y / 2
        
        for i = 1, 3 do
            VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.Begin, cx, cy)
            task.wait(0.1)
            VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.End, cx, cy)
            task.wait(0.1)
        end
    end
end

-- Button Toggle Event
ToggleBtn.MouseButton1Click:Connect(function()
    AutoFarm = not AutoFarm
    ToggleBtn.Text = AutoFarm and "FARM: ON" or "FARM: OFF"
    ToggleBtn.BackgroundColor3 = AutoFarm and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(180, 50, 50)
end)

-- Main Execution Loop
task.spawn(function()
    while true do
        task.wait(0.15)
        
        if AutoFarm then
            local folder = Workspace:FindFirstChild("world_chests")
            if folder then
                local chests = folder:GetChildren()
                
                for i = 1, #chests do
                    if not AutoFarm then break end
                    
                    local chest = chests[i]
                    if chest and chest.Parent and Targets[chest.Name] then
                        
                        -- Find Target CFrame safely
                        local targetCFrame = nil
                        if chest:IsA("BasePart") then
                            targetCFrame = chest.CFrame
                        elseif chest:IsA("Model") and chest.PrimaryPart then
                            targetCFrame = chest.PrimaryPart.CFrame
                        elseif chest:FindFirstChildWhichIsA("BasePart") then
                            targetCFrame = chest:FindFirstChildWhichIsA("BasePart").CFrame
                        end

                        if targetCFrame then
                            -- Move & trigger interaction
                            MoveToTarget(targetCFrame)
                            task.wait(0.05)
                            
                            MultiInteract(chest)
                            task.wait(0.1)
                        end
                    end
                end
            end
        end
    end
end)
