-- Services & Local Cache
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local AutoFarmActive = false

-- Config & Cache
local ChestFolder = Workspace:WaitForChild("world_chests", 5)
local TargetNames = {
    ["normal_chest_spawn"] = true,
    ["medium_chest_spawn"] = true,
    ["big_chest_spawn"] = true,
    ["large_chest_spawn"] = true
}

-- Compact Mobile ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MiniChestFarm"
ScreenGui.ResetOnSpawn = false

if syn and syn.protect_gui then
    syn.protect_gui(ScreenGui)
    ScreenGui.Parent = CoreGui
elseif gethui then
    ScreenGui.Parent = gethui()
else
    ScreenGui.Parent = CoreGui
end

-- Compact Frame
local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 100, 0, 40)
Frame.Position = UDim2.new(0.5, -50, 0.1, 0)
Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Draggable = true
Frame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 6)
UICorner.Parent = Frame

-- Toggle Button
local ToggleButton = Instance.new("TextButton")
ToggleButton.Size = UDim2.new(0.85, 0, 0.7, 0)
ToggleButton.Position = UDim2.new(0.075, 0, 0.15, 0)
ToggleButton.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
ToggleButton.Text = "FARM: OFF"
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.TextSize = 12
ToggleButton.Parent = Frame

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 4)
BtnCorner.Parent = ToggleButton

-- Helper Functions
local function GetRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function DirectInteract(target)
    pcall(function()
        for _, item in ipairs(target:GetDescendants()) do
            if item:IsA("ProximityPrompt") and item.Enabled then
                if fireproximityprompt then
                    fireproximityprompt(item)
                else
                    item:InputHoldBegin()
                    task.wait(0.1)
                    item:InputHoldEnd()
                end
                task.wait(0.1)
            elseif item:IsA("ClickDetector") then
                if fireclickdetector then
                    fireclickdetector(item)
                else
                    item:Click()
                end
                task.wait(0.1)
            end
        end
    end)
end

-- Toggle Event
ToggleButton.MouseButton1Click:Connect(function()
    AutoFarmActive = not AutoFarmActive
    ToggleButton.Text = AutoFarmActive and "FARM: ON" or "FARM: OFF"
    ToggleButton.BackgroundColor3 = AutoFarmActive and Color3.fromRGB(40, 150, 60) or Color3.fromRGB(150, 40, 40)
end)

-- Main Loop with Instance Tracking
task.spawn(function()
    local processedChests = {} -- Tracks recently interacted instances

    while true do
        task.wait(0.2)
        
        if AutoFarmActive and ChestFolder then
            local root = GetRoot()
            if root then
                local children = ChestFolder:GetChildren()
                
                for i = 1, #children do
                    if not AutoFarmActive then break end
                    
                    local child = children[i]
                    -- Check both the name match AND if this specific instance was processed this cycle
                    if child and child.Parent and TargetNames[child.Name] and not processedChests[child] then
                        
                        local cframe = nil
                        pcall(function()
                            if child:IsA("BasePart") then
                                cframe = child.CFrame
                            elseif child:IsA("Model") and child.PrimaryPart then
                                cframe = child.PrimaryPart.CFrame
                            elseif child:FindFirstChildWhichIsA("BasePart") then
                                cframe = child:FindFirstChildWhichIsA("BasePart").CFrame
                            end
                        end)

                        if cframe and root and root.Parent then
                            root.CFrame = cframe + Vector3.new(0, 0.3, 0)
                            task.wait(0.15)
                            
                            DirectInteract(child)
                            processedChests[child] = true -- Mark this exact instance as done
                            task.wait(0.15)
                        end
                    end
                end
                
                -- Clear tracking list after sweeping all current chests in the folder
                table.clear(processedChests)
            end
        end
    end
end)
