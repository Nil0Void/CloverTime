-- Active NoClip Function
local function ToggleNoclip(state)
    if state then
        if not NoclipConnection then
            NoclipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, v in ipairs(char:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

-- Safely Get CFrame
local function GetChestCFrame(chest)
    if chest:IsA("BasePart") then
        return chest.CFrame
    elseif chest:IsA("Model") then
        return chest:GetPivot()
    end
    return nil
end

-- Teleport Exactly 5 Studs Below Chest
local function FastTeleport(targetCFrame)
    local char = LocalPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Position calculation: 5 studs directly under the chest
    local goalCFrame = targetCFrame * CFrame.new(0, -5, 0)
    
    char:PivotTo(goalCFrame)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

-- Optimized Fast Interaction Logic
local function FastInteract(chest)
    local found = false
    
    for _, desc in ipairs(chest:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled then
            found = true
            for i = 1, 3 do
                if fireproximityprompt then
                    fireproximityprompt(desc)
                else
                    desc:InputHoldBegin()
                    task.wait(0.05)
                    desc:InputHoldEnd()
                end
            end
        elseif desc:IsA("ClickDetector") then
            found = true
            for i = 1, 3 do
                if fireclickdetector then
                    fireclickdetector(desc)
                else
                    desc:Click()
                end
            end
        end
    end

    -- Fast Screen Taps fallback
    if not found then
        local viewport = Workspace.CurrentCamera.ViewportSize
        local cx, cy = viewport.X / 2, viewport.Y / 2
        for i = 1, 3 do
            VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.Begin, cx, cy)
            task.wait(0.05)
            VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.End, cx, cy)
        end
    end
end

-- Button Toggle Event
ToggleBtn.MouseButton1Click:Connect(function()
