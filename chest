-- Deep Search for Remotes
local function GetRemote(name)
    local found = ReplicatedStorage:FindFirstChild(name, true)
    if not found then
        found = Workspace:FindFirstChild(name, true)
    end
    return found
end

-- Server Hop Function
local function ServerHop()
    StatusLabel.Text = "Status: Hopping Server..."
    local placeId = game.PlaceId
    local servers = {}
    
    pcall(function()
        local req = request or http_request or (syn and syn.request)
        if req then
            local res = req({
                Url = string.format("https://games.roblox.com/v1/games/%d/servers/0?sortOrder=Asc&limit=100", placeId),
                Method = "GET"
            })
            if res and res.Body then
                local body = HttpService:JSONDecode(res.Body)
                if body and body.data then
                    for _, v in ipairs(body.data) do
                        if v.playing and v.maxPlayers and v.playing < v.maxPlayers and v.id ~= game.JobId then
                            table.insert(servers, v.id)
                        end
                    end
                end
            end
        end
    end)

    if #servers > 0 then
        TeleportService:TeleportToPlaceInstance(placeId, servers[math.random(1, #servers)], LocalPlayer)
    else
        TeleportService:Teleport(placeId, LocalPlayer)
    end
end

-- Active NoClip Function
local function ToggleNoclip(state)
    if state then
        if not NoclipConnection then
            NoclipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, v in ipairs(char:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

-- Helper to safely get nil instances
local function GetNilInstance(name)
    if getnilinstances then
        for _, v in next, getnilinstances() do
            if v.Name == name then
                return v
            end
        end
    end
    return nil
end

-- Dynamically Find Active Item Key/GUID from LocalPlayer or Character
local function GetDynamicEquipKey()
    local detectedKey = nil
    
    local searchLocations = {LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character}
    for _, loc in ipairs(searchLocations) do
        if loc then
            for _, item in ipairs(loc:GetChildren()) do
                local itemGuid = item:GetAttribute("Guid") or item:GetAttribute("ID") or item:GetAttribute("Key")
                if itemGuid then
                    detectedKey = tostring(itemGuid)
                    break
                end
                
                for _, attr in ipairs(item:GetChildren()) do
                    if attr:IsA("StringValue") and (attr.Name:lower():find("id") or attr.Name:lower():find("key") or attr.Name:lower():find("guid")) then
                        detectedKey = attr.Value
                        break
                    end
                end
            end
        end
    end
    
    return detectedKey
end

-- Safely Get CFrame
local function GetChestCFrame(chest)
    if chest:IsA("BasePart") then
        return chest.CFrame
    elseif chest:IsA("Model") then
        return chest:GetPivot()
    end
    return nil
end

-- Teleport 7 Studs Underground
local function FastTeleport(targetCFrame)
    local char = LocalPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local goalCFrame = targetCFrame * CFrame.new(0, -7, 0)
    
    char:PivotTo(goalCFrame)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

-- Optimized Fast Interaction Logic
local function FastInteract(chest)
    local found = false
    
    for _, desc in ipairs(chest:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled then
            found = true
            for i = 1, 3 do
                if fireproximityprompt then
                    fireproximityprompt(desc)
                else
                    desc:InputHoldBegin()
                    task.wait(0.05)
                    desc:InputHoldEnd()
                end
            end
        elseif desc:IsA("ClickDetector") then
            found = true
            for i = 1, 3 do
                if fireclickdetector then
                    fireclickdetector(desc)
                else
                    desc:Click()
                end
            end
        end
    end

    if not found then
        local viewport = Workspace.CurrentCamera.ViewportSize
        local cx, cy = viewport.X / 2, viewport.Y / 2
        for i = 1, 3 do
            VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.Begin, cx, cy)
            task.wait(0.05)
            VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.End, cx, cy)
        end
    end
end

