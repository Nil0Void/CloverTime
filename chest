-- Safely get CFrame
local function GetChestCFrame(chest)
    if chest:IsA("BasePart") then
        return chest.CFrame
    elseif chest:IsA("Model") then
        return chest:GetPivot()
    end
    return nil
end

-- Teleport and Sync
local function HardTeleport(targetCFrame)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local goalCFrame = targetCFrame + Vector3.new(0, 0.3, 0)

    pcall(function()
        LocalPlayer:RequestStreamAroundAsync(goalCFrame.Position)
    end)

    char:PivotTo(goalCFrame)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

-- Interaction Logic
local function Interact(chest)
    local found = false
    for _, desc in ipairs(chest:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled then
            found = true
            for i = 1, 3 do
                if fireproximityprompt then
                    fireproximityprompt(desc)
                else
                    desc:InputHoldBegin()
                    task.wait(0.1)
                    desc:InputHoldEnd()
                end
                task.wait(0.1)
            end
        elseif desc:IsA("ClickDetector") then
            found = true
            for i = 1, 3 do
                if fireclickdetector then
                    fireclickdetector(desc)
                else
                    desc:Click()
                end
                task.wait(0.1)
            end
        end
    end

    if not found then
        local viewport = Workspace.CurrentCamera.ViewportSize
        local cx, cy = viewport.X / 2, viewport.Y / 2
        for i = 1, 3 do
            VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.Begin, cx, cy)
            task.wait(0.1)
            VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.End, cx, cy)
            task.wait(0.1)
        end
    end
end

-- Button Toggle Event
ToggleBtn.MouseButton1Click:Connect(function()
    AutoFarm = not AutoFarm
    ToggleBtn.Text = AutoFarm and "FARM: ON" or "FARM: OFF"
    ToggleBtn.BackgroundColor3 = AutoFarm and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(180, 50, 50)
    if not AutoFarm then
        Log("Idle")
    end
end)

-- Main Loop
task.spawn(function()
    while true do
        task.wait(0.2)
        
        if AutoFarm then
            local folder = Workspace:FindFirstChild("world_chests")
            
            if not folder then
                Log("No world_chests folder")
            else
                local children = folder:GetChildren()
                if #children == 0 then
                    Log("Folder is empty")
                else
                    local foundMatchingChest = false
                    
                    for i = 1, #children do
                        if not AutoFarm then break end
                        
                        local chest = children[i]
                        if chest and chest.Parent and Targets[chest.Name] then
                            foundMatchingChest = true
                            Log("Targeting: " .. chest.Name)
                            
                            local cframe = GetChestCFrame(chest)
                            if cframe then
                                HardTeleport(cframe)
                                task.wait(0.15)
                                Interact(chest)
                                task.wait(0.1)
                            end
                        end
                    end
                    
                    if not foundMatchingChest then
                        Log("No matching chest names")
                    end
                end
            end
        end
    end
end)
