-- Core Character Helper
local function GetRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- Safely find physical CFrame inside animated models
local function GetChestCFrame(chest)
    if chest:IsA("BasePart") then
        return chest.CFrame
    elseif chest:IsA("Model") then
        if chest.PrimaryPart then
            return chest.PrimaryPart.CFrame
        end
        -- Fallback: Find first BasePart inside the animated model
        local part = chest:FindFirstChildWhichIsA("BasePart", true)
        if part then
            return part.CFrame
        end
    end
    return nil
end

-- Execute Interactions
local function Interact(chest)
    local foundPrompt = false
    
    -- Check for Prompts/Clickers
    for _, desc in ipairs(chest:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled then
            foundPrompt = true
            for i = 1, 3 do
                if fireproximityprompt then
                    fireproximityprompt(desc)
                else
                    desc:InputHoldBegin()
                    task.wait(0.1)
                    desc:InputHoldEnd()
                end
                task.wait(0.1)
            end
        elseif desc:IsA("ClickDetector") then
            foundPrompt = true
            for i = 1, 3 do
                if fireclickdetector then
                    fireclickdetector(desc)
                else
                    desc:Click()
                end
                task.wait(0.1)
            end
        end
    end

    -- Fallback: Screen Taps
    if not foundPrompt then
        local viewport = Workspace.CurrentCamera.ViewportSize
        local cx, cy = viewport.X / 2, viewport.Y / 2
        for i = 1, 3 do
            VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.Begin, cx, cy)
            task.wait(0.1)
            VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.End, cx, cy)
            task.wait(0.1)
        end
    end
end

-- Toggle Event
ToggleBtn.MouseButton1Click:Connect(function()
    AutoFarm = not AutoFarm
    ToggleBtn.Text = AutoFarm and "FARM: ON" or "FARM: OFF"
    ToggleBtn.BackgroundColor3 = AutoFarm and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(180, 50, 50)
end)

-- Crash-Proof Main Loop
task.spawn(function()
    while true do
        task.wait(0.1)
        
        if AutoFarm then
            pcall(function()
                local folder = Workspace:FindFirstChild("world_chests")
                local root = GetRoot()
                
                if folder and root then
                    local chests = folder:GetChildren()
                    
                    for i = 1, #chests do
                        if not AutoFarm then break end
                        
                        local chest = chests[i]
                        if chest and chest.Parent and Targets[chest.Name] then
                            local cframe = GetChestCFrame(chest)
                            
                            if cframe then
                                -- Instant TP 0.3 units above the model's part
                                root.CFrame = cframe + Vector3.new(0, 0.3, 0)
                                task.wait(0.1)
                                
                                Interact(chest)
                                task.wait(0.1)
                            end
                        end
                    end
                end
            end)
        end
    end
end)
